{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  // Do not rebase when the default branch is updated
  "rebaseWhen": "never",
  "dependencyDashboardApproval": false,

  customManagers: [
    {
      customType: 'regex',
      description: 'Match container images in Justfile with tag and digest',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '[^\\s]+\\s*:=\\s*(?:env\\([^,]+,\\s*)?["\'](?<depName>[a-z0-9./_-]+):(?<currentValue>[a-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]+)["\']\\)?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: 'Match versioned GitHub release artifacts in build scripts',
      managerFilePatterns: [
        '/^build/.*\\.sh$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\w+_VERSION="(?<currentValue>[^"]+)"',
      ],
    },
  ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "description": "Auto-merge digest updates for all container images",
      "automerge": true,
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "labels": ["renovate", "automerge"],
      // Override the global rebaseWhen: "never". Base image manifests expire
      // after 28 days on quay, so a branch left un-rebased here rots into an
      // unbuildable pin instead of merely going stale.
      "rebaseWhen": "auto",
    },
    {
      "description": "Exclude Claude workflow files from updates to avoid review validation failures",
      "enabled": false,
      "matchDepTypes": ["action"],
      "matchFileNames": [".github/workflows/claude*.yml"],
    },
  ]
}
