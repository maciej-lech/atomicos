// Replaces Fedora's rule of the same name, which also lets wheel layer
// packages, roll back and clean up without a password. Only metadata refresh
// and upgrades stay passwordless; everything else falls back to auth_admin_keep.
polkit.addRule(function(action, subject) {
    if ((action.id === "org.projectatomic.rpmostree1.repo-refresh" ||
         action.id === "org.projectatomic.rpmostree1.upgrade") &&
        subject.active === true &&
        subject.local === true) {
            return polkit.Result.YES;
    }
});
